.DS_Store
.env
.idea/
.vs/
.vscode/
*.log
node_modules/
thumbs.db

# npm package
.npmrc
npm-debug.log.*

# ESLint cache
.eslintcache*

# Electron builder
*.provisionprofile
build/*.plist
dist/electron/*
dist/web/*
src/renderer/dist-electron/*

# Release output
release/*

# Extension build output (scripts/build-extension.js)
dist/extension/

# FluxCore engine source (binaries live in extra/)
FluxCore/

# XferRust engine repo (nested git repo, build artifacts stay out of this repo;
# release binaries are deployed to extra/ and tracked there)
# 必须锚定到仓库根目录：未锚定的 "XferRust/" 在 macOS（大小写不敏感）上会
# 同时匹配 src/shared/xferrust/，导致引擎适配层（XferRust.js 等）被静默
# 排除在版本控制之外，改动无法被 review / 回滚。
/XferRust/

# ZuvRust 媒体引擎（原名 MediaEngine）：**独立仓库**，源码不入前端仓库。
# 它是自研的 Rust 音视频引擎（容器/mux/取流/软解），有自己的一套工作区与
# 构建产物（target/ 上万文件），混进宿主仓库只会让 diff 与 review 失真。
# 与上一段同理必须锚定到仓库根：未锚定的 "ZuvRust/" 会在 macOS（大小写不敏感）
# 下匹配到别处，而 "MediaEngine/" 一样要锚定 —— 旧目录名的残留也别放进来。
/ZuvRust/
/MediaEngine/

# Android client：源码必须入库（CI 需构建 APK），仅忽略构建产物。
# 具体构建产物规则见 Android/.gitignore（.gradle / .kotlin / build / local.properties 等）
Android/.gradle/
Android/.kotlin/
Android/build/
Android/app/build/
Android/local.properties
Android/.idea/
Android/.DS_Store
Android/**/.DS_Store
Android/.cxx/
Android/captures/

# LinkCore website build output
linkcore-site/

# WorkBuddy project data (memory / skills / caches)
.workbuddy/

# CI release artifact extraction staging (xferrust-<platform>/)
/xferrust-*/

# Electron singleton runtime files
SingletonCookie
SingletonLock
SingletonSocket

# Temporary files
temp/

# 签名密钥：严禁入库（本地生成后只在 CI secrets 中配置；泄露=可冒名发布）
*.keystore
*.jks
*.p12
*.pfx
*.b64
*.key

# Python 缓存（误提交过 generate_icons.cpython-313.pyc）
__pycache__/
*.pyc
*.pyo

# Jishi 引擎（已放弃，2026-09 决定改用自研 ZuvRust，当时的目录名是 MediaEngine）：
# 该目录里只有 QML 前端 + 一份 x86_64 的 libmedia_capi.dylib —— 源码不在磁盘、
# 无 git 仓库、没有任何 merge/mux 接口、也没有可执行 CLI，无法作为引擎使用。
# 保留在磁盘上仅供查阅，不入库。自研引擎见 /ZuvRust/。
/Jishi-main/

# 临时试验目录（本地生成，不入库）
/tmp_spawntest/
