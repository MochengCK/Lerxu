    "@electron/osx-sign": "^1.3.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vueuse/core": "^11.0.0",
    "ajv": "^8.20.0",
    "bittorrent-peerid": "^1.3.6",
    "cfonts": "^3.3.1",
    "chalk": "^4.1.2",
