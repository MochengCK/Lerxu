{
  "name": "lerxu",
  "version": "v3.2.4",
  "description": "Cross-platform download manager for Windows, macOS, Linux and Android — HTTP(S), BitTorrent, HLS, SFTP and LAN transfer on an in-house Rust engine.",
  "homepage": "https://github.com/MochengCK/Lerxu",
  "author": {
    "name": "MochengCK",
    "email": "mocheng@example.com"
  },
  "copyright": "Copyright© 2024 MochengCK",
  "license": "Apache-2.0",
  "main": "./dist/electron/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MochengCK/Lerxu.git"
  },
  "scripts": {
    "release": "npm run build -- --publish onTagOrDraft",
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:applesilicon": "vite build && electron-builder --arm64 --mac",
    "build:github": "vite build",
    "build:dir": "vite build && electron-builder --dir",
    "preview": "vite preview",
    "build:extension": "node scripts/build-extension.js",
    "test:extension": "node test/extension/run.js",
    "test:zuvrust": "node test/zuvrust/run.mjs",
    "test:packaging": "node test/packaging/run.mjs",
    "test:playback": "node --import ./test/playback/register-alias.mjs test/playback/run.mjs",
    "test:taskpair": "node --import ./test/playback/register-alias.mjs test/taskpair/run.mjs",
    "test:mergeinput": "node test/mergeinput/run.mjs",
    "test:announcetime": "node test/announcetime/run.mjs",
    "test:avpair": "node test/avpair/run.mjs",
    "lint:extension": "npx --yes web-ext@8 lint --source-dir $(ls dist/extension/artifacts/lerxu-webextension-firefox-*.zip | head -1)",
    "lint": "eslint --ext .js,.vue src",
    "lint:workflows": "node scripts/check-workflows.js",
    "lint:fix": "eslint --ext .js,.vue --fix src",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "electron-log": "^5.4.4",
    "ip2region.js": "^3.1.8",
    "js-yaml": "^5.5.0",
    "semver": "^7.8.6",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@bany/curl-to-json": "^1.2.10",
    "@electron/notarize": "^3.1.2",
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "bittorrent-peerid": "^2.0.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "element-plus": "^2.14.8",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "flag-icons": "^7.6.0",
    "globals": "^17.14.0",
    "normalize.css": "^8.0.1",
    "parse-torrent": "^11.0.24",
    "pinia": "^4.1.0",
    "randomatic": "^3.1.1",
    "sass": "^1.108.2",
    "terser": "^5.51.4",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.4.0",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.46",
    "vue-eslint-parser": "^10.4.2",
    "vue-i18n": "^11.4.24",
    "vue-router": "^5.5.3"
  }
}
