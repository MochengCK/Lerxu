    "normalize.css": "^8.0.1",
    "parse-torrent": "^9.1.5",
    "pinia": "^2.2.0",
    "randomatic": "^3.1.1",
    "sass": "^1.77.0",
    "terser": "^5.50.0",
    "unplugin-auto-import": "^0.18.0",
