  },
  "scripts": {
    "release": "npm run build -- --publish onTagOrDraft",
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:applesilicon": "vite build && electron-builder --arm64 --mac",
    "build:github": "vite build",
    "build:dir": "vite build && electron-builder --dir",
    "preview": "vite preview",
    "build:extension": "node scripts/build-extension.js",
    "test:extension": "node test/extension/run.js",
    "lint:extension": "npx --yes web-ext@8 lint --source-dir $(ls dist/extension/artifacts/lerxu-webextension-firefox-*.zip | head -1)",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src",
    "lint:workflows": "node scripts/check-workflows.js",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@motrix/nat-api": "^0.3.4",
