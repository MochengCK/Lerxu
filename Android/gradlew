##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       not a POSIX-compliant shell, you need to specify the path to your
#       POSIX-compliant shell via the SHELL environment variable.
#
#   (2) This script targets any POSIX-architecture system.
#
#   Busybox implementations of shell utilities (such as `sed` and `sort`) are
#   known to be very slow. Using a modern shell implementation (such as bash or
#       zsh) is recommended.
#
#   (3) This script relies on the `java` command to be available in the PATH.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    # Handle the case where a script is called via symlink, e.g. /usr/local/bin/gradle
    if [ -n "$APP_HOME" ] && [ ! -d "$APP_HOME" ]; then
        # The script is run from a symlink. Resolve it.
        link=$(readlink "$app_path")
        # If the link is absolute, use it as is. Otherwise, make it relative to APP_HOME.
        if [[ "$link" == /* ]]; then
            app_path=$link
        else
            app_path=$APP_HOME$link
        fi
    fi
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
# Discard cd standard output in case $CDPATH is set (https://github.com/gradle/gradle/issues/23122).
APP_HOME=$( cd "${APP_HOME:-./gradle}" > /dev/null && cd "${0%/*}/gradle" 2>/dev/null && pwd -P ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that, which is important for Cygwin,
# and is needed for older versions of busybox where `ulimit` does not support the `-a` parameter.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$(uname)" in
  CYGWIN* )
    cygwin=true
    ;;
  Darwin* )
    darwin=true
    ;;
  MSYS* | MINGW* )
    msys=true
    ;;
  NONSTOP* )
    nonstop=true
    ;;
esac

CLASSPATH=$APP_HOME/wrapper/gradle-wrapper.jar

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# For Cygwin or MSYS, ensure the JAVA_HOME is in the right format.
if $cygwin || $msys ; then
    [ -n "$JAVA_HOME" ] && JAVA_HOME=$(cygpath --path --mixed "$JAVA_HOME")
fi

# For Cygwin or MSYS, ensure the CLASSPATH is in the right format.
if $cygwin || $msys ; then
    [ -n "$CLASSPATH" ] && CLASSPATH=$(cygpath --path --mixed "$CLASSPATH")
fi

# Increase the maximum file descriptors if we can.
if ! $cygwin && ! $darwin && ! $nonstop ; then
    case $MAX_FD in
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in
      '' | soft | :*)
        # In POSIX sh, ulimit is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC2039,SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the java command, stacking in reverse order:
#   * args from the command line
#   * the JVM option(s)
#   * the -classpath
#   * the Gradle classpath
#   * -Dgradle.user.home=...
#   * -Dorg.gradle.appname=...
#   * -Dorg.gradle.daemon=false
#   * -Dorg.gradle.launcher=false
set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# Stop when "xargs -P" is not available
if command -v xargs >/dev/null 2>&1
then
    :
else
    die "ERROR: xargs command not found. Install it via your package manager."
fi

# Use "xargs" to parse quoted args.
#
# With -n1 it outputs one arg per line, with the quotes and backslashes removed.
#
# Additionally, @- is supported, which reads from stdin.
#
# This works around the issue when arguments contain spaces or special characters,
# and no extra quoting is needed.
#
# The "xargs" line below is intentionally not in a subshell, because we need to
# collect the exit status.
eval "set -- $(
        printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
        xargs -n1 |
        sed ' s~[^-[:alnum:]+,./:=@_]~\\&~g; ' |
        tr '\n' ' '
    )" '"$@"'

exec "$JAVACMD" "$@"
