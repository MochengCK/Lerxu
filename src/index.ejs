<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>LinkCore Download Manager</title>
  </head>

  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
      /* 与主题 --lc-bg-main 保持一致（浅色 #f0f4f8 / 深色 #1e2228），
         避免窗口加载瞬间闪旧背景色 */
      background-color: #f0f4f8;
    }

    #app {
      height: 100%;
    }

    @media (prefers-color-scheme: dark) {
      html, body {
        background-color: #1e2228;
      }
    }
  </style>

  <body>
    <div id="app"></div>
    <!-- Set `__static` path to static files in production -->
    <% if (!htmlWebpackPlugin.options.isBrowser && !htmlWebpackPlugin.options.isDev) { %>
      <script>
        window.__static = require('path').join(__dirname, '/static').replace(/\\/g, '\\\\')
      </script>
    <% } %>

    <!-- macOS 原生透明背景：UI 加载前同步读取配置，若开启则保持
         html/body 透明，避免窗口加载瞬间闪现不透明背景色。
         仅对主窗口（index）提前透明——偏好设置窗口需等待 Vue 渲染
         出带不透明背景的内容区后再由 App.vue 切换透明，否则在 Vue
         渲染前窗口完全透明、内容不可见。 -->
    <script>
      try {
        if (process.platform === 'darwin') {
          var config = require('electron').ipcRenderer.sendSync('get-app-config')
          if (config && config['mac-native-transparent']) {
            var isPreferenceWindow = typeof window !== 'undefined' &&
              window.location && window.location.hash &&
              window.location.hash.indexOf('preference-window') !== -1
            if (!isPreferenceWindow) {
              document.documentElement.className = 'mac-native-transparent'
              document.documentElement.style.backgroundColor = 'transparent'
              document.body.style.backgroundColor = 'transparent'
            }
          }
        }
      } catch (e) {}
    </script>

    <!-- webpack builds are automatically injected -->
  </body>
</html>
